{
  "name": "opencode-command-hotkeys",
  "version": "0.1.1",
  "description": "Configurable session command hotkeys for the OpenCode TUI",
  "license": "MIT",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/ex10se/opencode-command-hotkeys.git" },
  "bugs": { "url": "https://github.com/ex10se/opencode-command-hotkeys/issues" },
  "homepage": "https://github.com/ex10se/opencode-command-hotkeys#readme",
  "keywords": ["opencode", "plugin", "tui", "hotkeys"],
  "engines": { "node": ">=22.18.0" },
  "exports": { "./tui": { "types": "./dist/tui.d.ts", "import": "./dist/tui.js" } },
  "files": ["dist", "LICENSE", "README.md", "README.ru.md", "CHANGELOG.md", "CONTRIBUTING.md", "SECURITY.md", "docs"],
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:dependencies": "node test/dependencies/run.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "prepack": "npm run typecheck && npm run build"
  },
  "devDependencies": { "@opencode/plugin": "2.2.5", "@types/node": "22.19.0", "typescript": "5.9.3" },
  "overrides": { "glob": "14.0.3", "minimatch": "11.0.4" }
}
